# Copy to .env for local runs (`pnpm dev` / `make dev`). Deployed environments inject these directly.
NODE_ENV=development
PORT=3004
LOG_LEVEL=info
# SERVICE_NAME=payment-mock

# Both required; values match infra/docker/docker-compose.yml. `?schema=payment-mock` is where
# `make migrate` puts this service's tables. KAFKA_BROKERS is Redpanda's external listener.
DATABASE_URL=postgresql://app:app@localhost:5434/flashsale?schema=payment-mock
KAFKA_BROKERS=localhost:19092

# Optional: probability a new mock charge fails (a stored charge is never re-rolled).
# FAIL_RATE=0.2
# Partitions handled at once (default 1: one charge in flight per process). It cannot usefully exceed the
# partitions a process owns: payments.commands has 80, so 4 processes x 20 uses them all.
# PAYMENT_CONCURRENCY=1
