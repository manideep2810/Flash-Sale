# Copy to .env for local runs (`pnpm dev` / `make dev`). Deployed environments inject these directly.
NODE_ENV=development
PORT=3002
LOG_LEVEL=info
# SERVICE_NAME=relay

# Not used until the Redis/Kafka clients are wired in (values match infra/docker/docker-compose.yml).
REDIS_URL=redis://localhost:6379
KAFKA_BROKERS=localhost:19092
