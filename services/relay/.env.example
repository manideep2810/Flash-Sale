# Copy to .env for local runs (`pnpm dev` / `make dev`). Deployed environments inject these directly.
NODE_ENV=development
PORT=3002
LOG_LEVEL=info
# SERVICE_NAME=relay

# Both required; values match infra/docker/docker-compose.yml. REDIS_URL must be the Redis the ticket
# service writes its reservation streams to. KAFKA_BROKERS is Redpanda's external listener: Redpanda
# speaks the Kafka protocol, so the relay reaches it with a Kafka client.
REDIS_URL=redis://localhost:6380
KAFKA_BROKERS=localhost:19092
