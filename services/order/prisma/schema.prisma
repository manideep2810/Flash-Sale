// Models for the order service's own database. Add models, then run `prisma migrate dev`.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// 1. The Order (ticket reservation)
model Order {
  id        String     @id // Same as reservationId/holdId
  eventId   String // Which event
  userId    String // Which user
  qty       Int // How many tickets
  state     OrderState @default(HELD) // Current state (HELD, PAID, CONFIRMED, etc.)
  expiresAt DateTime // When the hold expires
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([eventId, state]) // Speed up queries like "find all HELD orders for this event"
}

// 2. Track which events we've already processed (for dedupe)
model ProcessedEvent {
  eventId     String   @id // stream:entry-id from Redis
  processedAt DateTime @default(now())
}

// 3. All possible order states (like an enum)
enum OrderState {
  HELD // Just reserved, waiting for payment
  PAYMENT_PENDING // Payment started
  PAID // Payment confirmed
  CONFIRMED // Order confirmed, ticket issued
  EXPIRED // Hold expired, ticket released
  PAYMENT_FAILED // Payment declined
  REFUNDED // Refund issued
  RELEASED // Hold released early
}
