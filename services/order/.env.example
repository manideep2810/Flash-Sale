# Copy to .env for local runs (`pnpm dev` / `make dev`). Deployed environments inject these directly.
NODE_ENV=development
PORT=3003
LOG_LEVEL=info
# SERVICE_NAME=order

# Both required; values match infra/docker/docker-compose.yml. `?schema=order` is where `make migrate`
# puts this service's tables. KAFKA_BROKERS is Redpanda's external listener: Redpanda speaks the Kafka
# protocol, so the consumer reaches it with a Kafka client.
DATABASE_URL=postgresql://app:app@localhost:5434/flashsale?schema=order
KAFKA_BROKERS=localhost:19092

# Optional: what every order is charged, in the smallest currency unit.
# PAY_AMOUNT=999

# Two processes share this codebase and this file: the API (PORT) and the worker (WORKER_PORT, probes
# and /metrics only). The worker settles holds in Redis, so REDIS_URL is required there.
WORKER_PORT=3006
REDIS_URL=redis://localhost:6380

# Optional tuning (defaults shown).
# TIMEOUT_JOB_INTERVAL_MS=5000   how often HELD orders past their hold are expired
# PAYMENT_STALE_SEC=60           a PAYMENT_PENDING order older than this is asked about again
# SWEEPER_INTERVAL_MS=30000      period of the payment-request and hold-settlement sweepers
# RESULT_CONSUMER_CONCURRENCY=1      partitions the payment-result and hold-settlement consumers handle at once

# Sessions. The API signs them at POST /auth/dev-login (dev only: no password) and verifies them on
# /orders. Every service that verifies a session must be given this same value; at least 32 bytes.
# This value is for local runs only.
SESSION_SECRET=local-dev-only-session-secret-0123456789abcdef0

# The admin login (POST /auth/admin-login): one fixed password, at least 8 characters. Leave it unset
# and there is no admin login. This value is for local runs only.
ADMIN_PASSWORD=flash-admin-2026
