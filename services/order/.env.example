# Copy to .env for local runs (`pnpm dev` / `make dev`). Deployed environments inject these directly.
NODE_ENV=development
PORT=3003
LOG_LEVEL=info
# SERVICE_NAME=order

# Not used until the Postgres/Kafka clients are wired in (values match infra/docker/docker-compose.yml).
DATABASE_URL=postgresql://app:app@localhost:5432/flashsale?schema=order
KAFKA_BROKERS=localhost:19092
