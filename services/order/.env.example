# Copy to .env for local runs (`pnpm dev` / `make dev`). Deployed environments inject these directly.
NODE_ENV=development
PORT=3003
LOG_LEVEL=info
# SERVICE_NAME=order

# Both required; values match infra/docker/docker-compose.yml. `?schema=order` is where `make migrate`
# puts this service's tables. KAFKA_BROKERS is Redpanda's external listener: Redpanda speaks the Kafka
# protocol, so the consumer reaches it with a Kafka client.
DATABASE_URL=postgresql://app:app@localhost:5434/flashsale?schema=order
KAFKA_BROKERS=localhost:19092
