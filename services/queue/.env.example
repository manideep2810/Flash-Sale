# Copy to .env for local runs (`pnpm dev` / `make dev`). Deployed environments inject these directly.
NODE_ENV=development
PORT=4100
LOG_LEVEL=info
# SERVICE_NAME=queue

# Required. Host port matches infra/docker/docker-compose.yml and the Makefile (6380). It must be the
# Redis the ticket service uses: admit.lua reads that service's avail and holds keys.
REDIS_URL=redis://localhost:6380

# Signs the admission JWT (HS256). At least 32 bytes. This value is for local runs only.
ADMISSION_SECRET=local-dev-only-admission-secret-0123456789abcdef

# Two processes share this codebase and this file: queue-svc (PORT) and queue-admitter (ADMITTER_PORT,
# /healthz and /metrics only). Run exactly one admitter.
ADMITTER_PORT=3011
