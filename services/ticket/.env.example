# Copy to .env for local runs (`pnpm dev` / `make dev`). Deployed environments inject these directly.
NODE_ENV=development
PORT=3001
LOG_LEVEL=info
# SERVICE_NAME=ticket

# Host ports match infra/docker/docker-compose.yml and the Makefile (5434/6380, since 5432/6379 are
# commonly taken by other local stacks). DATABASE_URL is required for the /baseline/* routes.
REDIS_URL=redis://localhost:6380
DATABASE_URL=postgresql://app:app@localhost:5434/flashsale?schema=ticket
# Baseline concurrency experiments (src/baseline): pg pool size.
PG_POOL_MAX=20

# Redis hot path (src/redis): REDIS_POOL is a round-robin set of connections, since ioredis itself
# has no pool. The hold's TTL (HOLD_TTL_SEC, or HOLD_TTL_MS to override it) becomes its expiry score in the
# holds ZSET; the order service expires and settles holds against the same instant.
REDIS_POOL=10
HOLD_TTL_SEC=600

# Process model (src/index.ts): the primary forks WORKERS node:cluster workers that share PORT and
# serves prom-client Node metrics for all of them on METRICS_PORT (scraped as job "ticket" by
# infra/prometheus.yml). The pools above are per worker, so total connections scale with WORKERS.
# WORKERS defaults to the number of logical CPUs.
# WORKERS=4
METRICS_PORT=9464
