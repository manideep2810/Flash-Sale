# Copy to .env for local runs (`pnpm dev` / `make dev`). Deployed environments inject these directly.
NODE_ENV=development
PORT=3001
LOG_LEVEL=info
# SERVICE_NAME=ticket

# Not used until the Redis/Postgres clients are wired in (values match infra/docker/docker-compose.yml).
REDIS_URL=redis://localhost:6379
DATABASE_URL=postgresql://app:app@localhost:5432/flashsale?schema=ticket
