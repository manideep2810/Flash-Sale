# Production environment. Copy to .env and fill in secrets.
#
# Generate secrets with: openssl rand -base64 48
# All values below are required; no defaults in production.

# ---- Docker Compose (infra/docker/.env) ----
SESSION_SECRET=generate-with-openssl-rand-base64-48
ADMISSION_SECRET=generate-with-openssl-rand-base64-48
POSTGRES_PASSWORD=generate-with-openssl-rand-base64-48
GRAFANA_ADMIN_PASSWORD=generate-with-openssl-rand-base64-48

# ---- Order API (services/order/.env) ----
NODE_ENV=production
PORT=3003
LOG_LEVEL=warn
SERVICE_NAME=order
DATABASE_URL=postgresql://app:PASSWORD@localhost:5434/flashsale?schema=order
KAFKA_BROKERS=localhost:19092
WORKER_PORT=3006
REDIS_URL=redis://localhost:6380
ADMIN_PASSWORD=generate-with-openssl-rand-base64-16-min-8-chars
TIMEOUT_JOB_INTERVAL_MS=5000
PAYMENT_STALE_SEC=60
SWEEPER_INTERVAL_MS=30000
RESULT_CONSUMER_CONCURRENCY=1
PAY_AMOUNT=999

# ---- Ticket Service (services/ticket/.env) ----
NODE_ENV=production
PORT=3001
LOG_LEVEL=warn
SERVICE_NAME=ticket
DATABASE_URL=postgresql://app:PASSWORD@localhost:5434/flashsale?schema=ticket
REDIS_URL=redis://localhost:6380
SESSION_SECRET=generate-with-openssl-rand-base64-48
ADMISSION_SECRET=generate-with-openssl-rand-base64-48
WORKERS=2
METRICS_PORT=9464
REQUIRE_ADMISSION=true
REDIS_POOL=10
PG_POOL_MAX=20

# ---- Queue Service (services/queue/.env) ----
NODE_ENV=production
PORT=4100
LOG_LEVEL=warn
SERVICE_NAME=queue
REDIS_URL=redis://localhost:6380
SESSION_SECRET=generate-with-openssl-rand-base64-48
ADMISSION_SECRET=generate-with-openssl-rand-base64-48
ADMITTER_PORT=3011

# ---- Relay (services/relay/.env) ----
NODE_ENV=production
PORT=3002
LOG_LEVEL=warn
SERVICE_NAME=relay
REDIS_URL=redis://localhost:6380
KAFKA_BROKERS=localhost:19092

# ---- Payment Mock (services/payment-mock/.env) ----
NODE_ENV=production
PORT=3004
LOG_LEVEL=warn
SERVICE_NAME=payment-mock
DATABASE_URL=postgresql://app:PASSWORD@localhost:5434/flashsale?schema=payment-mock
KAFKA_BROKERS=localhost:19092
FAIL_RATE=0.0
PAYMENT_CONCURRENCY=3

# ---- Web (web/.env) ----
# No env needed at runtime; NEXT_PUBLIC_CURRENCY is inlined at build time.
NODE_ENV=production
