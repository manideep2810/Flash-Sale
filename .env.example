# Production stack (infra/docker/docker-compose.prod.yml, run by scripts/deploy.sh).
#
#   cp .env.example .env     then replace every change-me value
#
# Generate each secret with:   openssl rand -base64 48
# except POSTGRES_PASSWORD:    openssl rand -hex 24      (it goes inside a URL, so letters and digits only)
#
# Every variable here is required: compose refuses to start when one is missing, and deploy.sh
# refuses while any value still says change-me. Local development does not use this file: `make dev`
# reads services/*/.env and `make up` reads infra/docker/.env.

# Signs and checks the login sessions: order-api issues them; envoy, ticket and queue-svc verify them.
SESSION_SECRET=change-me

# Signs and checks the waiting room's admission tokens: queue-svc issues them; envoy and ticket verify.
ADMISSION_SECRET=change-me

# The Postgres user `app`. Set it before the first deploy: Postgres only reads it when it creates
# its data volume.
POSTGRES_PASSWORD=change-me

# The admin page's password (POST /api/auth/admin-login). At least 8 characters.
ADMIN_PASSWORD=change-me

# Grafana's `admin` user, on 127.0.0.1:3000 (SSH tunnel). Read when Grafana first creates its database.
GRAFANA_ADMIN_PASSWORD=change-me
