# Local rate limits: one token bucket per route, shared by everything this Envoy instance serves.
# They protect the services from a flood whoever it comes from; the per-user and per-address limits
# are the global ones in infra/ratelimit/config/flashsale.yaml.
#
# entrypoint.sh writes these into envoy.yaml at container start. A bucket holds MAX_TOKENS and gains
# TOKENS_PER_FILL every LOCAL_FILL_INTERVAL, so the sustained rate is TOKENS_PER_FILL / interval.
# The test stack swaps this file for limits.test.env.
LOCAL_FILL_INTERVAL=0.1s

# reserve: about 1,000/s
LOCAL_RESERVE_MAX_TOKENS=1000
LOCAL_RESERVE_TOKENS_PER_FILL=100

# status: about 3,000/s
LOCAL_STATUS_MAX_TOKENS=3000
LOCAL_STATUS_TOKENS_PER_FILL=300

# join: about 2,000/s
LOCAL_JOIN_MAX_TOKENS=2000
LOCAL_JOIN_TOKENS_PER_FILL=200

# login: about 200/s
LOCAL_LOGIN_MAX_TOKENS=200
LOCAL_LOGIN_TOKENS_PER_FILL=20

# info (the event page): about 3,000/s. It has no global limit, so this is its only cap.
LOCAL_INFO_MAX_TOKENS=3000
LOCAL_INFO_TOKENS_PER_FILL=300

# web (pages and /_next assets): about 2,000/s. Its only cap as well.
LOCAL_WEB_MAX_TOKENS=2000
LOCAL_WEB_TOKENS_PER_FILL=200

# admin login: about 5/s for everyone together. The per-address limit that matters is the global one.
LOCAL_ADMIN_LOGIN_MAX_TOKENS=10
LOCAL_ADMIN_LOGIN_TOKENS_PER_FILL=1

# events (the catalogue: listing and event pages): about 3,000/s. It has no global limit.
LOCAL_EVENTS_MAX_TOKENS=3000
LOCAL_EVENTS_TOKENS_PER_FILL=300

# admin (the admin page's API): about 50/s. One admin with a dashboard open asks far less.
LOCAL_ADMIN_MAX_TOKENS=100
LOCAL_ADMIN_TOKENS_PER_FILL=5
