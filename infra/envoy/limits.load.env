# Local rate limits for LOAD RUNS, loaded after limits.env by infra/docker/docker-compose.load.yml
# (`make load-profile`; `make normal-profile` goes back). Only what differs from limits.env is here.
#
# A load run plays tens of thousands of users from one machine. The local buckets are per route for
# everyone together, so they are raised to what that crowd honestly sends; nothing else changes.
# The bot-flood run does NOT use this file: it is run against the normal limits.

# status: 15,000/s (the same as the normal profile; repeated so this file says all three)
LOCAL_STATUS_MAX_TOKENS=15000
LOCAL_STATUS_TOKENS_PER_FILL=1500

# join: 5,000/s
LOCAL_JOIN_MAX_TOKENS=5000
LOCAL_JOIN_TOKENS_PER_FILL=500

# reserve: 2,000/s
LOCAL_RESERVE_MAX_TOKENS=2000
LOCAL_RESERVE_TOKENS_PER_FILL=200
