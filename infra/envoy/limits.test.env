# Local rate limits for the gateway tests (tests/e2e/phase5/gateway.test.ts), loaded after limits.env
# by infra/docker/docker-compose.test.yml. Same meaning as there, different numbers.
#
# Only the login bucket is small: 5 requests, refilled every 5 seconds, so a test can empty it with a
# burst of 20 and know exactly how many must be refused. The others are far above anything the tests
# send, so that only the limit a test is about can refuse its requests.
LOCAL_FILL_INTERVAL=5s

LOCAL_LOGIN_MAX_TOKENS=5
LOCAL_LOGIN_TOKENS_PER_FILL=5

LOCAL_RESERVE_MAX_TOKENS=5000
LOCAL_RESERVE_TOKENS_PER_FILL=5000

LOCAL_STATUS_MAX_TOKENS=5000
LOCAL_STATUS_TOKENS_PER_FILL=5000

LOCAL_JOIN_MAX_TOKENS=5000
LOCAL_JOIN_TOKENS_PER_FILL=5000

LOCAL_INFO_MAX_TOKENS=5000
LOCAL_INFO_TOKENS_PER_FILL=5000

LOCAL_WEB_MAX_TOKENS=5000
LOCAL_WEB_TOKENS_PER_FILL=5000

LOCAL_ADMIN_LOGIN_MAX_TOKENS=5000
LOCAL_ADMIN_LOGIN_TOKENS_PER_FILL=5000

LOCAL_EVENTS_MAX_TOKENS=5000
LOCAL_EVENTS_TOKENS_PER_FILL=5000

LOCAL_ADMIN_MAX_TOKENS=5000
LOCAL_ADMIN_TOKENS_PER_FILL=5000
