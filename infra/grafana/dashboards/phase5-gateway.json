      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, envoy_cluster_name) (rate(envoy_cluster_upstream_rq_time_bucket[1m])))",
          "legendFormat": "{{envoy_cluster_name}}"
        }
      ]
    },
    {
      "id": 6,
      "title": "ratelimit service: OVER_LIMIT per limit",
      "description": "How often the ratelimit service answered OVER_LIMIT, per second, for each limit it holds: the route, and whether the user or the client address went over. One request can trip both.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 18
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "label_replace(sum by (key1, key2) (rate(ratelimit_service_rate_limit_over_limit{domain=\"flashsale\"}[1m])), \"route\", \"$1\", \"key1\", \"generic_key_(.*)\")",
          "legendFormat": "{{route}} / {{key2}}"
        }
      ]
