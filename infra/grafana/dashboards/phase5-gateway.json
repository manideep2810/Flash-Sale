    {
      "id": 5,
      "title": "Upstream latency per cluster (p95)",
      "description": "95th percentile of the time a cluster took to answer Envoy, in milliseconds. order-api, ticket and queue-svc are the services on the host; ratelimit is the rate-limit service, which Envoy stops waiting for after 50 ms; web is the Next.js app.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 18
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "min": 0,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "order-api"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#008300"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "ticket"
            },
            "properties": [
