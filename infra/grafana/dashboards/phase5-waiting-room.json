    {
      "id": 10,
      "title": "429s: local bucket vs global limit",
      "description": "The same 429s, by which limit refused them: the route's own token bucket in Envoy (local, everyone together) or the ratelimit service (global: one user or one client address over its allowance).",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 34
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "local bucket"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#9085e9"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "global limit"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#d55181"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(envoy_gateway_requests{code=\"429\", reason=\"local_rate_limited\"}[$__rate_interval]))",
          "legendFormat": "local bucket"
        },
        {
          "refId": "B",
          "expr": "sum(rate(envoy_gateway_requests{code=\"429\", reason=\"request_rate_limited\"}[$__rate_interval]))",
          "legendFormat": "global limit"
        }
      ]
    },
    {
      "id": 11,
