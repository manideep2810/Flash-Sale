{
  "uid": "phase5-waiting-room",
  "title": "Phase 5 - Waiting room",
  "tags": [
    "phase5",
    "waiting-room"
  ],
  "editable": true,
  "refresh": "5s",
  "schemaVersion": 39,
  "version": 1,
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "timezone": "browser",
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      },
      {
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "iconColor": "#d03b3b",
        "name": "Chaos",
        "target": {
          "type": "tags",
          "tags": [
            "chaos"
          ],
          "matchAny": false,
          "limit": 100
        }
      }
    ]
  },
  "templating": {
    "list": [
      {
        "name": "event",
        "label": "Event",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(queue_joins_total, event)",
          "refId": "event"
        },
        "definition": "label_values(queue_joins_total, event)",
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "refresh": 2,
        "sort": 2
      },
      {
        "name": "admit_rate",
        "label": "Admit rate (per second)",
        "type": "textbox",
        "query": "50",
        "current": {
          "selected": false,
          "text": "50",
          "value": "50"
        },
        "options": [
          {
            "selected": true,
            "text": "50",
            "value": "50"
          }
        ]
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Joins, admissions and reserves per second",
      "description": "THE panel. Joins is the crowd arriving (queue-svc). Admitted is what the admitter lets through, which is the event's configured rate and no more. Reserves is what then reaches the ticket service through the gateway. The point of the waiting room: however high Joins goes, Admitted stays flat at the configured rate, and Reserves stays under it.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Joins"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#d95926"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Admitted"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#3987e5"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Reserves reaching the ticket service"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#199e70"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(queue_joins_total{event=~\"$event\"}[$__rate_interval]))",
          "legendFormat": "Joins"
        },
        {
          "refId": "B",
          "expr": "sum(rate(queue_admitted_total{event=~\"$event\"}[$__rate_interval]))",
          "legendFormat": "Admitted"
        },
        {
          "refId": "C",
          "expr": "sum(rate(envoy_vhost_route_upstream_rq_total{envoy_route=\"reserve\"}[$__rate_interval]))",
          "legendFormat": "Reserves reaching the ticket service"
        }
      ]
    },
    {
      "id": 2,
      "title": "Queue depth",
      "description": "Users waiting in line, per event (the admitter samples ZCARD once a second).",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 10
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (event) (queue_depth{event=~\"$event\"})",
          "legendFormat": "{{event}}"
        }
      ]
    },
    {
      "id": 3,
      "title": "Estimated drain time",
      "description": "Queue depth divided by the admit rate: how long until the last person now in line is let in. The rate is the $admit_rate variable at the top (the event's configured rate is not a metric), so set it to the run's.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 10
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(queue_depth{event=~\"$event\"}) / $admit_rate",
          "legendFormat": "depth / $admit_rate per second"
        }
      ]
    },
    {
      "id": 4,
      "title": "Event state",
      "description": "What the admitter last found: OPEN (admitting), PAUSED (no stock, but tickets are in checkouts and may come back) or SOLD_OUT (nothing left and nothing held).",
      "type": "state-timeline",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 10
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "#8e8d85"
          },
          "custom": {
            "fillOpacity": 80,
            "lineWidth": 0,
            "spanNulls": false
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "OPEN",
                  "color": "#0ca30c",
                  "index": 0
                },
                "2": {
                  "text": "PAUSED",
                  "color": "#fab219",
                  "index": 1
                },
                "3": {
                  "text": "SOLD_OUT",
                  "color": "#8e8d85",
                  "index": 2
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#8e8d85",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "mergeValues": true,
        "showValue": "always",
        "rowHeight": 0.85,
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "single"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (event) (event_state{event=~\"$event\", state=\"OPEN\"}) + 2 * sum by (event) (event_state{event=~\"$event\", state=\"PAUSED\"}) + 3 * sum by (event) (event_state{event=~\"$event\", state=\"SOLD_OUT\"})",
          "legendFormat": "{{event}}"
        }
      ]
    },
    {
      "id": 5,
      "title": "Status requests per second, by answer",
      "description": "Polls answered by queue-svc, by what it answered. QUEUED is the waiting crowd; it falls as the line drains, and once an event is SOLD_OUT the clients stop asking.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 18
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (rate(queue_status_requests_total{event=~\"$event\"}[$__rate_interval]))",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "id": 6,
      "title": "Admission check at the ticket service",
      "description": "Reserves that reached the ticket service, by what its admission check said: accepted, or refused and why. In a clean run only 'accepted' moves; in a bot flood only TOKEN_MISMATCH does, because the gateway stops every other kind before it gets here.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 18
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(admission_accepted_total[$__rate_interval]))",
          "legendFormat": "accepted"
        },
        {
          "refId": "B",
          "expr": "sum by (reason) (rate(admission_rejected_total[$__rate_interval]))",
          "legendFormat": "{{reason}}"
        }
      ]
    },
