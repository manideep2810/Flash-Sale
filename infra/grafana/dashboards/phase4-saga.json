{
  "uid": "phase4-saga",
  "title": "Phase 4 - Saga",
  "tags": ["phase4", "saga"],
  "schemaVersion": 39,
  "version": 2,
  "editable": true,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "timezone": "browser",
  "templating": {
    "list": [
      {
        "name": "event",
        "label": "Sale",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(inventory_units, event)",
          "refId": "event"
        },
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "current": {
          "selected": true,
          "text": ["All"],
          "value": ["$__all"]
        },
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "State mismatches",
      "description": "payment_state_mismatch_total: payment results that fit no PAYMENT_PENDING order. Green at 0.",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "noValue": "0",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(payment_state_mismatch_total) or vector(0)",
          "legendFormat": "State mismatches"
        }
      ]
    },
    {
      "id": 2,
      "title": "Hold missing on confirm",
      "description": "hold_missing_on_confirm_total: a PAID order's Redis hold was already gone (oversell risk). Green at 0.",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "noValue": "0",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(hold_missing_on_confirm_total) or vector(0)",
          "legendFormat": "Hold missing on confirm"
        }
      ]
    },
    {
      "id": 3,
      "title": "Oversell (units)",
      "description": "oversell_units: units sold (PAID orders) above the stock. Green at 0.",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "noValue": "0",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(oversell_units) or vector(0)",
          "legendFormat": "Oversell (units)"
        }
      ]
    },
    {
      "id": 4,
      "title": "Double charges",
      "description": "payment_double_charges: orders with more than one payments row. Green at 0.",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "noValue": "0",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(payment_double_charges) or vector(0)",
          "legendFormat": "Double charges"
        }
      ]
    },
    {
      "id": 5,
      "title": "Inventory I1: avail + held + sold = total",
      "description": "Stacked avail, held and sold against the stock (dashed line), all read from Redis. held is a counter that reserve.lua increments in the same atomic step that takes the units from avail, and that confirm.lua (held to sold) and release.lua (held to avail) decrement. So the stack stays flat at the line at every instant.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 10,
        "w": 16,
        "x": 0,
        "y": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "stacking": {
              "mode": "normal"
            },
            "fillOpacity": 45,
            "lineWidth": 1
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "total"
            },
            "properties": [
              {
                "id": "custom.stacking",
                "value": {
                  "mode": "none",
                  "group": "A"
                }
              },
              {
                "id": "custom.fillOpacity",
                "value": 0
              },
              {
                "id": "custom.lineWidth",
                "value": 3
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "white"
                }
              },
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [10, 10]
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": ["lastNotNull", "min", "max"]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(inventory_units{kind=\"avail\", event=~\"$event\"})",
          "legendFormat": "avail"
        },
        {
          "refId": "B",
          "expr": "sum(inventory_units{kind=\"held\", event=~\"$event\"})",
          "legendFormat": "held"
        },
        {
          "refId": "C",
          "expr": "sum(inventory_units{kind=\"sold\", event=~\"$event\"})",
          "legendFormat": "sold"
        },
        {
          "refId": "D",
          "expr": "sum(inventory_units{kind=\"total\", event=~\"$event\"})",
          "legendFormat": "total"
        }
      ]
    },
    {
      "id": 6,
      "title": "Held: Redis counter vs Postgres orders",
      "description": "The Redis held counter against the quantity of orders whose hold is still open in Postgres. The Postgres line trails while orders are still being created from the reservation events (the order-creation backlog), then meets the counter. A gap that stays open once the system is quiet would be a leak.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 10,
        "w": 8,
        "x": 16,
        "y": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": ["lastNotNull", "max"]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(inventory_units{kind=\"held\", event=~\"$event\"})",
          "legendFormat": "held (Redis counter)"
        },
        {
          "refId": "B",
          "expr": "sum(inventory_units{kind=\"held_db\", event=~\"$event\"})",
          "legendFormat": "held (Postgres orders)"
        }
      ]
    },
    {
      "id": 7,
      "title": "Orders by state",
      "description": "Orders currently in each state, counted from Postgres at scrape time.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 14
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "stacking": {
              "mode": "normal"
            },
            "fillOpacity": 45,
            "lineWidth": 1
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": ["lastNotNull", "max"]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (state) (orders_by_state)",
          "legendFormat": "{{state}}"
        }
      ]
    },
    {
      "id": 8,
      "title": "Oldest PAYMENT_PENDING age",
      "description": "Seconds since the oldest PAYMENT_PENDING order was last requested. Should stay under PAYMENT_STALE_SEC plus a sweep.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 14
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": ["lastNotNull", "max"]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(oldest_payment_pending_age_seconds)",
          "legendFormat": "oldest"
        }
      ]
    },
    {
      "id": 9,
      "title": "Payment outcomes per second",
      "description": "Charges decided by the payment service, by outcome.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 22
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "SUCCEEDED"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "FAILED"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": ["lastNotNull", "max"]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (rate(payments_decided_total[1m]))",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "id": 10,
      "title": "/pay latency p50 / p99",
      "description": "Time to answer POST /orders/:id/pay (the charge itself is asynchronous). Empty when nothing was paid in the last minute.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 22
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "min": 0,
          "noValue": "no /pay traffic"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": ["lastNotNull", "max"]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le) (rate(order_pay_duration_ms_bucket[1m])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(order_pay_duration_ms_bucket[1m])))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "id": 11,
      "title": "/reserve requests per second",
      "description": "Reserve attempts per second reaching the ticket service, from the k6 run (phase4.js streams to Prometheus like the baseline run does). Empty outside a load run.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 30
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "noValue": "no load run"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": ["lastNotNull", "max"]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(k6_http_reqs_total{name=\"reserve\"}[$__rate_interval]))",
          "legendFormat": "reserve rps"
        }
      ]
    },
    {
      "id": 12,
      "title": "/reserve latency p99",
      "description": "p99 of POST /reserve as measured by k6. Empty outside a load run.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 30
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "noValue": "no load run"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": ["lastNotNull", "max"]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(k6_http_req_duration_p99{name=\"reserve\"})",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "id": 13,
      "title": "Consumer lag per group",
      "description": "Messages each consumer group has not committed yet.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 38
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": ["lastNotNull", "max"]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (group) (kafka_consumer_lag)",
          "legendFormat": "{{group}}"
        }
      ]
    },
    {
      "id": 14,
      "title": "Self-healing activity",
      "description": "How often the safety nets had to step in: PaymentRequested sent again by the stale sweeper, holds settled by the settlement sweeper. Not failures, but a steady climb means the fast path is losing messages.",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 38
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": ["lastNotNull", "max"]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(payment_request_republished_total[1m]))",
          "legendFormat": "payment request republished"
        },
        {
          "refId": "B",
          "expr": "sum(rate(hold_settlement_backstop_total[1m]))",
          "legendFormat": "hold settled by sweeper"
        }
      ]
    }
  ]
}
