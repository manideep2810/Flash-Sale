{
  "uid": "k6-baseline",
  "title": "k6 Baseline Reserve",
  "tags": ["k6", "baseline"],
  "schemaVersion": 39,
  "version": 2,
  "editable": true,
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "timezone": "browser",
  "templating": {
    "list": [
      {
        "name": "variant",
        "label": "Variant",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": { "query": "label_values(k6_http_reqs_total, variant)", "refId": "variant" },
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "current": { "selected": true, "text": ["All"], "value": ["$__all"] },
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Request rate",
      "description": "Reserve requests per second actually achieved, per variant.",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "reqps", "min": 0 }, "overrides": [] },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (variant) (rate(k6_http_reqs_total{name=\"reserve\", variant=~\"$variant\"}[$__rate_interval]))",
          "legendFormat": "{{variant}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "Latency (p50 / p95 / p99)",
      "description": "http_req_duration for reserve calls. Worst series across response statuses.",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "s", "min": 0 }, "overrides": [] },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (variant) (k6_http_req_duration_p50{name=\"reserve\", variant=~\"$variant\"})",
          "legendFormat": "{{variant}} p50"
        },
        {
          "refId": "B",
          "expr": "max by (variant) (k6_http_req_duration_p95{name=\"reserve\", variant=~\"$variant\"})",
          "legendFormat": "{{variant}} p95"
        },
        {
          "refId": "C",
          "expr": "max by (variant) (k6_http_req_duration_p99{name=\"reserve\", variant=~\"$variant\"})",
          "legendFormat": "{{variant}} p99"
        }
      ]
    },
    {
      "id": 3,
      "title": "Reserve outcomes",
      "description": "Custom counters from loadtest/baseline.js: 201 ok, 409 sold out, anything else error.",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "fieldConfig": { "defaults": { "unit": "ops", "min": 0 }, "overrides": [] },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (variant) (rate(k6_reserve_ok_total{variant=~\"$variant\"}[$__rate_interval]))",
          "legendFormat": "{{variant}} ok"
        },
        {
          "refId": "B",
          "expr": "sum by (variant) (rate(k6_reserve_sold_out_total{variant=~\"$variant\"}[$__rate_interval]))",
          "legendFormat": "{{variant}} sold out"
        },
        {
          "refId": "C",
          "expr": "sum by (variant) (rate(k6_reserve_error_total{variant=~\"$variant\"}[$__rate_interval]))",
          "legendFormat": "{{variant}} error"
        }
      ]
    },
    {
      "id": 4,
      "title": "Failed request ratio",
      "description": "Share of reserve requests with an unexpected status (not 201/409). The k6 threshold is 1%.",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "custom": { "thresholdsStyle": { "mode": "line" } },
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 0.01 }]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum by (variant) (rate(k6_http_reqs_total{name=\"reserve\", expected_response=\"false\", variant=~\"$variant\"}[$__rate_interval])) or sum by (variant) (rate(k6_http_reqs_total{name=\"reserve\", variant=~\"$variant\"}[$__rate_interval])) * 0) / sum by (variant) (rate(k6_http_reqs_total{name=\"reserve\", variant=~\"$variant\"}[$__rate_interval]))",
          "legendFormat": "{{variant}}"
        }
      ]
    },
    {
      "id": 5,
      "title": "Virtual users",
      "description": "Active VUs. With an arrival-rate executor, rising VUs mean responses are slowing down.",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "fieldConfig": { "defaults": { "unit": "short", "min": 0 }, "overrides": [] },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (variant) (k6_vus{variant=~\"$variant\"})",
          "legendFormat": "{{variant}} active"
        },
        {
          "refId": "B",
          "expr": "max by (variant) (k6_vus_max{variant=~\"$variant\"})",
          "legendFormat": "{{variant}} allocated"
        }
      ]
    },
    {
      "id": 6,
      "title": "Dropped iterations",
      "description": "Requests k6 could not start because all VUs were busy. Non-zero means the system under test cannot keep up with TARGET_RPS.",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "fieldConfig": { "defaults": { "unit": "ops", "min": 0 }, "overrides": [] },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (variant) (rate(k6_dropped_iterations_total{variant=~\"$variant\"}[$__rate_interval]))",
          "legendFormat": "{{variant}}"
        }
      ]
    },
    {
      "id": 7,
      "title": "Node CPU per worker (cores)",
      "description": "CPU seconds each ticket cluster worker burns per wall-clock second (prom-client process_cpu_seconds_total). A worker is single-threaded, so 1.0 means it is saturated and the service, not Postgres or Redis, is the bottleneck.",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "decimals": 2,
          "custom": { "thresholdsStyle": { "mode": "line" } },
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 1 }]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(process_cpu_seconds_total{job=\"ticket\"}[30s])",
          "legendFormat": "worker {{worker}}"
        }
      ]
    },
    {
      "id": 8,
      "title": "Event-loop lag p99 (ms)",
      "description": "99th percentile of event-loop delay per worker, from perf_hooks.monitorEventLoopDelay, reset every scrape. Lag climbing while CPU stays under 1.0 points at long synchronous work (GC, big JSON) rather than raw load.",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "fieldConfig": { "defaults": { "unit": "ms", "min": 0 }, "overrides": [] },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "nodejs_eventloop_lag_p99_seconds{job=\"ticket\"} * 1000",
          "legendFormat": "worker {{worker}}"
        }
      ]
    }
  ]
}
