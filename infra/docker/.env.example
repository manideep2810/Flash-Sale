# Copy to .env (`make env` does, and `make up` does when it is missing). docker compose reads the .env
# beside docker-compose.yml and hands these two to the gateway, which verifies both tokens at the edge.
#
# They must be the same values the services run with: SESSION_SECRET in services/order, ticket and
# queue, ADMISSION_SECRET in services/ticket and queue. At least 32 bytes each. These values are for
# local runs only.
SESSION_SECRET=local-dev-only-session-secret-0123456789abcdef0
ADMISSION_SECRET=local-dev-only-admission-secret-0123456789abcdef
